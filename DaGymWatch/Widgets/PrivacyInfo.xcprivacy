<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!--
	 This extension has no backend and no analytics SDK. It only reads the WatchSnapshot
	 the DaGymWatch app writes to the shared App Group; nothing is transmitted off-device
	 to the developer or a third party, so nothing is "collected" per Apple's definition.
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		 UserDefaults(suiteName: "group.dev.abdirahmanmohamed.dagym") — App Group suite
		 shared with the DaGymWatch app, used to read the WatchSnapshot the app writes.
		 Reason 1C8F.1: reading/writing data accessible only to this app and its App Group.
		 DaGymWatch/Shared/WatchSnapshot.swift:31 (compiled into this target)
		 DaGymWatch/Shared/WatchSnapshot.swift:34
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>1C8F.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
