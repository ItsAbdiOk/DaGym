#!/bin/sh
# Runs before every push. Broken code never leaves this machine, so nothing
# broken can reach Xcode Cloud / TestFlight.
#
# Enable with:  git config core.hooksPath .githooks
# Bypass once:  git push --no-verify   (use sparingly)
set -eu

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

RED=$(printf '\033[31m'); GREEN=$(printf '\033[32m'); OFF=$(printf '\033[0m')
fail() { printf "%spre-push: %s%s\n" "$RED" "$1" "$OFF" >&2; exit 1; }
ok()   { printf "%s  ok%s  %s\n" "$GREEN" "$OFF" "$1"; }

echo "pre-push checks..."

# 1. Code only. Planning docs and agent files must never be tracked.
for f in plan.md design-brief.md CLAUDE.md; do
    if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
        fail "$f is tracked by git. This repo is code only."
    fi
done
if git ls-files | grep -qE '^(\.claude|docs|mockups|design)/'; then
    fail "a non-code directory is tracked (.claude/, docs/, mockups/ or design/)."
fi
if git grep -nE '(sk-ant-|sk-|AIza)[A-Za-z0-9_\-]{16,}' -- . ':(exclude)*Tests*' >/dev/null 2>&1; then
    fail "An API-key-shaped string is present in a tracked file."
fi
ok "code only, no credentials"

# 2. Lint.
command -v swiftlint >/dev/null 2>&1 || fail "swiftlint is not installed. Run: brew install swiftlint"
swiftlint lint --strict --quiet || fail "lint failed"
ok "lint clean"

# 3. project.yml is the source of truth; the committed .xcodeproj AND the generated Info.plists
# / entitlements it also writes must match (T10 — App Review reads the plists/entitlements, not
# the .xcodeproj; Xcode Cloud regenerates on every build, so a stale commit here is invisible
# until a reviewer diffs the repo).
command -v xcodegen >/dev/null 2>&1 || fail "xcodegen is not installed. Run: brew install xcodegen"
xcodegen generate --quiet 2>/dev/null || xcodegen generate >/dev/null 2>&1
GENERATED_PATHS="DaGym.xcodeproj DaGym/Info.plist DaGym/DaGym.entitlements \
    DaGymWidgets/Info.plist DaGymWidgets/DaGymWidgets.entitlements DaGymWatch/Info.plist"
if ! git diff --quiet -- $GENERATED_PATHS; then
    fail "a file xcodegen generates from project.yml is out of sync. Commit the regenerated files."
fi
ok "project in sync"

# 4. App tests + UI smoke test on the simulator (this also runs the GymCore suite — see
# verify.sh:12 — so it isn't repeated here; that used to double the ~300-test GymCore run on
# every push for no benefit). The slow step.
echo "  running scripts/verify.sh (this is the slow bit)..."
if ! ./scripts/verify.sh >/tmp/dagym-prepush.log 2>&1; then
    printf "%spre-push: tests failed%s\n" "$RED" "$OFF" >&2
    grep -E "✘|error:|Expectation failed|Test run with" /tmp/dagym-prepush.log \
        | sed 's/^/  /' | head -25 >&2
    echo "  full log: /tmp/dagym-prepush.log" >&2
    exit 1
fi
ok "app tests passed"

echo "pre-push checks passed."
